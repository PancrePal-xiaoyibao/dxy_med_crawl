# 丁香园药物信息爬虫 - 环境变量配置示例
# 复制此文件为 .env 并根据需要修改配置

# ================================
# 基础URL配置
# ================================

# 丁香园药物数据库基础URL
BASE_URL=https://drugs.dxy.cn

# Jina AI服务基础URL
JINA_BASE_URL=https://r.jina.ai

# ================================
# 目录配置
# ================================

# 输出目录 - 爬取结果存放位置
OUTPUT_DIR=./output

# 日志目录 - 系统日志存放位置
LOGS_DIR=./logs

# 数据目录 - 临时数据和缓存存放位置
DATA_DIR=./data

# ================================
# 网络请求配置
# ================================

# 请求延迟（秒）- 控制请求频率，避免被反爬虫
REQUEST_DELAY=1.0

# 最大重试次数 - 请求失败时的重试次数
MAX_RETRIES=3

# 请求超时时间（秒）
TIMEOUT=30

# 连接超时时间（秒）
CONNECT_TIMEOUT=10

# 读取超时时间（秒）
READ_TIMEOUT=30

# ================================
# 反爬虫配置
# ================================

# 是否使用代理（true/false）
USE_PROXY=false

# 代理服务器地址（如果USE_PROXY=true）
# PROXY_URL=http://username:password@proxy.example.com:8080

# 是否轮换User-Agent（true/false）
ROTATE_USER_AGENT=true

# 是否使用随机延迟（true/false）
RANDOM_DELAY=true

# 随机延迟范围（秒）
RANDOM_DELAY_MIN=0.5
RANDOM_DELAY_MAX=2.0

# Cookie管理配置
COOKIE_FILE=data/cookies.json
COOKIE_EXPIRE_HOURS=24
AUTO_REFRESH_COOKIES=true
COOKIE_VALIDATION_ENABLED=true
COOKIE_RETRY_ATTEMPTS=2

# ================================
# 并发和性能配置
# ================================

# 异步请求的最大并发数
MAX_CONCURRENT_REQUESTS=5

# 批处理大小
BATCH_SIZE=10

# 是否启用缓存（true/false）
ENABLE_CACHE=true

# 缓存过期时间（小时）
CACHE_EXPIRE_HOURS=24

# ================================
# 数据处理配置
# ================================

# 默认输出格式（json,csv,excel）
DEFAULT_OUTPUT_FORMAT=json,csv

# 是否启用数据清洗（true/false）
ENABLE_DATA_CLEANING=true

# 是否启用RAG优化（true/false）
ENABLE_RAG_OPTIMIZATION=true

# 文本分块大小（用于RAG优化）
CHUNK_SIZE=500

# 文本分块重叠大小
CHUNK_OVERLAP=50

# ================================
# Jina AI配置
# ================================

# 是否默认使用Jina AI处理（true/false）
USE_JINA_BY_DEFAULT=false

# Jina AI请求超时时间（秒）
JINA_TIMEOUT=60

# Jina AI最大重试次数
JINA_MAX_RETRIES=2

# ================================
# 日志配置
# ================================

# 日志级别（DEBUG, INFO, WARNING, ERROR, CRITICAL）
LOG_LEVEL=INFO

# 是否启用彩色日志（true/false）
ENABLE_COLOR_LOGS=true

# 是否启用性能监控（true/false）
ENABLE_PERFORMANCE_MONITORING=true

# 日志文件最大大小（MB）
LOG_FILE_MAX_SIZE=10

# 日志文件保留数量
LOG_FILE_BACKUP_COUNT=5

# ================================
# 安全配置
# ================================

# 是否验证SSL证书（true/false）
VERIFY_SSL=true

# 自定义User-Agent（如果不使用轮换）
# CUSTOM_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36

# ================================
# 数据库配置（可选）
# ================================

# 是否启用数据库存储（true/false）
ENABLE_DATABASE=false

# 数据库类型（sqlite, mysql, postgresql）
DATABASE_TYPE=sqlite

# SQLite数据库文件路径
SQLITE_DB_PATH=./data/drugs.db

# MySQL/PostgreSQL配置（如果使用）
# DATABASE_HOST=localhost
# DATABASE_PORT=3306
# DATABASE_NAME=drugs_db
# DATABASE_USER=username
# DATABASE_PASSWORD=password

# ================================
# 邮件通知配置（可选）
# ================================

# 是否启用邮件通知（true/false）
ENABLE_EMAIL_NOTIFICATIONS=false

# SMTP服务器配置
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# NOTIFICATION_EMAIL=admin@example.com

# ================================
# 监控和告警配置（可选）
# ================================

# 是否启用系统监控（true/false）
ENABLE_SYSTEM_MONITORING=false

# CPU使用率告警阈值（百分比）
CPU_ALERT_THRESHOLD=80

# 内存使用率告警阈值（百分比）
MEMORY_ALERT_THRESHOLD=80

# 磁盘使用率告警阈值（百分比）
DISK_ALERT_THRESHOLD=90

# ================================
# 开发和调试配置
# ================================

# 是否启用调试模式（true/false）
DEBUG_MODE=false

# 是否保存原始HTML（用于调试）
SAVE_RAW_HTML=false

# 是否启用详细错误信息（true/false）
VERBOSE_ERRORS=false

# 测试模式（true/false）- 限制爬取数量
TEST_MODE=false

# 测试模式下的最大爬取数量
TEST_MAX_ITEMS=5

# ================================
# 自定义配置
# ================================

# 项目名称
PROJECT_NAME=丁香园药物信息爬虫

# 项目版本
PROJECT_VERSION=1.0.0

# 作者信息
AUTHOR=AI Assistant

# 联系邮箱
CONTACT_EMAIL=support@example.com

# ================================
# 注意事项
# ================================

# 1. 请根据实际需要修改配置值
# 2. 布尔值请使用 true/false（小写）
# 3. 路径可以使用相对路径或绝对路径
# 4. 敏感信息（如密码）请妥善保管
# 5. 生产环境建议关闭调试模式
# 6. 请遵守目标网站的使用条款